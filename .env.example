# Supabase (server-only — service role key must never be exposed client-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (public — safe to expose; used by browser and middleware clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL — used when constructing magic-link redirect URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Note: RAZORPAY_KEY_ID (not the secret) is safe to expose and is returned
# to the browser via /api/orders/[slug]/pay — no separate NEXT_PUBLIC_ var needed.

# Resend (email notification for "build it for me" manual requests).
# Optional: if unset, requests still save to Supabase fine — they just log
# to the server console instead of emailing you. See ManualRequestService.
RESEND_API_KEY=re_xxxxxxxx
RESEND_TO_EMAIL=you@yourdomain.com
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Admin access
# ADMIN_EMAILS: comma-separated list of emails to grant admin role via scripts/grant-admin.ts
ADMIN_EMAILS=admin@yourdomain.com,another@yourdomain.com
# ADMIN_ALERT_EMAIL: receives urgent content-report notifications (e.g. minor-related flags)
ADMIN_ALERT_EMAIL=admin@yourdomain.com
